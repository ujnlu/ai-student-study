# SQLite（默认，零配置）: file:./data/dev.db
# PostgreSQL: postgresql://user:pass@localhost:5432/study
DATABASE_URL="file:./data/dev.db"

# 用于加密存储 AI Provider 的 API Key，以及签发登录 Cookie。请改成随机长字符串。
APP_SECRET="change-me-to-a-long-random-string"

# 家长端登录 PIN（首次启动时写入数据库，之后可在家长端修改）
PARENT_PIN="1234"

# 上传文件存放目录
UPLOAD_DIR="./data/uploads"
