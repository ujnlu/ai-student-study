// 小学 1-5 年级家用辅导站 · 数据模型

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- 家庭 / 账号 ----------

model Family {
  id            String   @id @default(cuid())
  name          String   @default("我家")
  pinHash       String
  dailyLimitMin Int      @default(60)
  createdAt     DateTime @default(now())
  children      Child[]
  providers     AiProvider[]
  assistants    AiAssistant[]
  settings      FamilySetting[]
  rewards       Reward[]
}

model FamilySetting {
  id       String @id @default(cuid())
  familyId String
  key      String
  value    String @db.LongText
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, key])
}

model Child {
  id        String   @id @default(cuid())
  familyId  String
  name      String
  avatar    String   @default("🐼")
  grade     Int // 1-6；家长自学的"学习者"为 0
  kind      String   @default("child") // child | adult（家长自学，不在孩子端登录页显示）
  semester  Int      @default(1) // 1 上学期 2 下学期
  region    String? // 省/市，如 "北京" "江苏-南京"
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  textbooks     ChildTextbook[]
  uploads       Upload[]
  attempts      Attempt[]
  mistakes      MistakeEntry[]
  conversations Conversation[]
  masteries     Mastery[]
  sessions      StudySession[]
  explanations  Explanation[]
  practiceSets  PracticeSet[]
  progress      ChildProgress[]
  stars         StarEvent[]
  recitations   Recitation[]
  redemptions   Redemption[]
}

// ---------- 教材 / 知识体系 ----------

model Subject {
  id        String @id // math | chinese | english
  name      String
  sortOrder Int    @default(0)

  textbookVersions TextbookVersion[]
  childTextbooks   ChildTextbook[]
  knowledgePoints  KnowledgePoint[]
  problems         Problem[]
  uploads          Upload[]
  textbooks        Textbook[]
}

/// 教材版本，如 人教版 / 北师大版 / 苏教版；可按学科细分
model TextbookVersion {
  id        String   @id @default(cuid())
  subjectId String
  code      String // renjiao | beishida | sujiao ...
  name      String
  publisher String?
  regions   String? // 常见使用地区，逗号分隔，仅作提示
  isBuiltin Boolean  @default(true)
  createdAt DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  childTextbooks  ChildTextbook[]
  knowledgePoints KnowledgePoint[]
  textbooks       Textbook[]

  @@unique([subjectId, code])
}

/// 孩子每个学科当前使用的教材版本（可随时切换）
model ChildTextbook {
  id                String          @id @default(cuid())
  childId           String
  subjectId         String
  textbookVersionId String
  child             Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  textbookVersion   TextbookVersion @relation(fields: [textbookVersionId], references: [id], onDelete: Cascade)

  @@unique([childId, subjectId])
}

model KnowledgePoint {
  id                String          @id @default(cuid())
  subjectId         String
  textbookVersionId String
  grade             Int
  semester          Int
  unit              String
  name              String
  description       String? @db.LongText
  sortOrder         Int             @default(0)
  chapterId         String?
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  textbookVersion   TextbookVersion @relation(fields: [textbookVersionId], references: [id], onDelete: Cascade)
  chapter           TextbookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  prerequisites KnowledgePrereq[] @relation("kpTarget")
  dependents    KnowledgePrereq[] @relation("kpPrereq")
  problems      Problem[]
  masteries     Mastery[]
  practiceSets  PracticeSet[]

  @@index([textbookVersionId, grade, semester])
}

model KnowledgePrereq {
  id       String         @id @default(cuid())
  kpId     String
  prereqId String
  kp       KnowledgePoint @relation("kpTarget", fields: [kpId], references: [id], onDelete: Cascade)
  prereq   KnowledgePoint @relation("kpPrereq", fields: [prereqId], references: [id], onDelete: Cascade)

  @@unique([kpId, prereqId])
}

// ---------- AI 配置 ----------

model AiProvider {
  id           String   @id @default(cuid())
  familyId     String
  name         String
  kind         String // anthropic | openai-compatible
  baseUrl      String?
  apiKeyEnc    String // AES-GCM 加密
  defaultModel String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assistants   AiAssistant[]
  usages       AiUsage[]
}

/// 一个"助手" = 角色 + 提示词模板 + 绑定的模型
model AiAssistant {
  id            String     @id @default(cuid())
  familyId      String
  providerId    String
  role          String // grade | tutor | generate | essay | ocr
  name          String
  model         String? // 不填则用 provider 默认模型
  systemPrompt  String @db.LongText
  temperature   Float      @default(0.3)
  maxTokens     Int        @default(0) // 0 = 自动（尽量大，截断自动续写）
  isDefault     Boolean    @default(false) // 该 role 的默认助手
  supportVision Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  family        Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  provider      AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  versions      AiPromptVersion[]
  usages        AiUsage[]

  @@index([familyId, role])
}

model AiPromptVersion {
  id           String      @id @default(cuid())
  assistantId  String
  systemPrompt String @db.LongText
  note         String?
  createdAt    DateTime    @default(now())
  assistant    AiAssistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
}

model AiUsage {
  id           String       @id @default(cuid())
  providerId   String
  assistantId  String?
  model        String
  inputTokens  Int          @default(0)
  outputTokens Int          @default(0)
  latencyMs    Int          @default(0)
  ok           Boolean      @default(true)
  error        String? @db.LongText
  createdAt    DateTime     @default(now())
  provider     AiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  assistant    AiAssistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
}

// ---------- 上传 / 题目 / 作答 ----------

model Upload {
  id          String    @id @default(cuid())
  childId     String
  subjectId   String?
  kind        String    @default("homework") // homework | single | exam | dictation
  meta        String? @db.LongText // JSON：听写时的词表等
  filePath    String
  mimeType    String
  width       Int?
  height      Int?
  status      String    @default("pending") // pending | grading | graded | failed
  error       String? @db.LongText
  summary     String? @db.LongText // AI 一句话总结
  rawResult   String? @db.LongText // AI 原始 JSON
  createdAt   DateTime  @default(now())
  gradedAt    DateTime?
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  problems    Problem[]

  @@index([childId, createdAt])
}

model Problem {
  id               String          @id @default(cuid())
  subjectId        String?
  uploadId         String?
  knowledgePointId String?
  chapterId        String?
  index            Int             @default(0)
  stem             String
  answer           String? // 正确答案
  solution         String? @db.LongText // 解析
  difficulty       Int             @default(2) // 1-5
  source           String          @default("upload") // upload | generated | bank | variant | lesson
  topic            String? // 专项 / 奥数专题代码（见 src/lib/topics.ts）；真题卷为 paper-<paperId>
  kind             String? // choice 选择 | fill 填空 | subjective 解答（解答题由学生对照参考答案自评）
  walkthrough      String? @db.LongText // AI 解题讲解（审题→思路→步骤→答案→易错），生成一次后缓存
  parentProblemId  String?
  createdAt        DateTime        @default(now())
  subject          Subject?        @relation(fields: [subjectId], references: [id])
  upload           Upload?         @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint? @relation(fields: [knowledgePointId], references: [id])
  chapter          TextbookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  attempts         Attempt[]
  mistakes         MistakeEntry[]
  explanations     Explanation[]
  practiceItems    PracticeItem[]

  @@index([topic, source])
}

model Attempt {
  id          String   @id @default(cuid())
  childId     String
  problemId   String
  childAnswer String? @db.LongText
  isCorrect   Boolean?
  errorType   String? // concept | calculation | reading | careless | unknown
  aiComment   String? @db.LongText
  box         String? // 图片上的位置 {x,y,w,h}，0-1 比例
  overridden  Boolean  @default(false) // 家长手动改判
  durationSec Int?
  createdAt   DateTime @default(now())
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
}

model MistakeEntry {
  id            String    @id @default(cuid())
  childId       String
  problemId     String
  status        String    @default("new") // new | explained | practicing | cleared
  errorType     String?
  reviewCount   Int       @default(0)
  nextReviewAt  DateTime?
  clearedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  problem       Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  practiceSets  PracticeSet[]

  @@unique([childId, problemId])
  @@index([childId, status])
}

model Conversation {
  id          String        @id @default(cuid())
  childId     String
  mistakeId   String?
  assistantId String?
  title       String?
  understood  Boolean?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  child       Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  mistake     MistakeEntry? @relation(fields: [mistakeId], references: [id], onDelete: SetNull)
  messages    Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String @db.LongText
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Mastery {
  id               String         @id @default(cuid())
  childId          String
  knowledgePointId String
  score            Int            @default(0) // 0-100
  attempts         Int            @default(0)
  correct          Int            @default(0)
  updatedAt        DateTime       @updatedAt
  child            Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@unique([childId, knowledgePointId])
}

model StudySession {
  id        String    @id @default(cuid())
  childId   String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  seconds   Int       @default(0)
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
}

/// AI 生成的分步讲解动画（每步 = SVG 画面 + 旁白）
model Explanation {
  id          String   @id @default(cuid())
  problemId   String
  childId     String
  assistantId String?
  title       String
  stepsJson   String @db.LongText // [{caption, narration, svg}]
  summary     String? @db.LongText
  quizQ       String? @db.LongText
  quizA       String? @db.LongText
  status      String   @default("ready") // ready | failed
  error       String? @db.LongText
  createdAt   DateTime @default(now())
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([problemId, childId])
}

// ---------- 练习（口算 / 变式题 / 复习 / AI 出题） ----------

model PracticeSet {
  id               String          @id @default(cuid())
  childId          String
  kind             String // oral | variant | review | ai | sync | unit | consolidate | weekly | topic | olympiad
  title            String
  status           String          @default("ready") // pending_review | ready | done
  mistakeId        String?
  knowledgePointId String?
  chapterId        String?
  topic            String? // 专项 / 奥数专题代码
  timeLimitSec     Int?
  total            Int             @default(0)
  score            Int?
  durationSec      Int?
  createdAt        DateTime        @default(now())
  completedAt      DateTime?
  child            Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  mistake          MistakeEntry?   @relation(fields: [mistakeId], references: [id], onDelete: SetNull)
  knowledgePoint   KnowledgePoint? @relation(fields: [knowledgePointId], references: [id], onDelete: SetNull)
  items            PracticeItem[]

  @@index([childId, status, createdAt])
}

model PracticeItem {
  id          String      @id @default(cuid())
  setId       String
  index       Int
  problemId   String
  childAnswer String? @db.LongText
  isCorrect   Boolean?
  set         PracticeSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  problem     Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([setId, index])
}

// ---------- 教材内容（从国家中小学智慧教育平台导入） ----------

model Textbook {
  id                String          @id @default(cuid())
  textbookVersionId String
  subjectId         String
  grade             Int
  semester          Int
  volume            String? // 册的显示名：上册/下册/全一册/必修 第一册（初高中按此显示，semester 只作排序）
  smarteduId        String          @unique
  title             String
  pdfPath           String?
  pageCount         Int             @default(0)
  frontPage         Int             @default(0) // 正文第 1 页对应的 PDF 页码偏移
  status            String          @default("pending") // pending | downloading | extracting | ocr | ready | failed
  contentSource     String          @default("pdf") // pdf | images
  progress          Int             @default(0) // 0-100
  error             String? @db.LongText
  sourceUpdatedAt   DateTime?
  importedAt        DateTime?
  createdAt         DateTime        @default(now())
  textbookVersion   TextbookVersion @relation(fields: [textbookVersionId], references: [id], onDelete: Cascade)
  subject           Subject         @relation(fields: [subjectId], references: [id])
  chapters          TextbookChapter[]
  pages             TextbookPage[]

  @@index([textbookVersionId, grade, semester])
}

model TextbookChapter {
  id         String   @id @default(cuid())
  textbookId String
  parentId   String?
  nodeId     String?
  title      String
  level      Int      @default(0)
  sortOrder  Int      @default(0)
  pageStart  Int?
  pageEnd    Int?
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  parent     TextbookChapter?  @relation("chapterTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   TextbookChapter[] @relation("chapterTree")
  knowledgePoints KnowledgePoint[]
  problems   Problem[]
  progress   ChildProgress[]
  wordList   WordList?
  reciteText ReciteText?
  recitations Recitation[]
  guide      LessonGuide?

  @@index([textbookId, sortOrder])
}

model TextbookPage {
  id         String   @id @default(cuid())
  textbookId String
  pageNo     Int // PDF 页码，1 起
  text       String
  imagePath  String?
  ocrStatus  String   @default("none") // none | pdf | ocr | failed
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  @@unique([textbookId, pageNo])
}

// ---------- 学习进度 / 激励 ----------

/// 孩子各学科"学校学到哪了"（当前章节），同步练习据此出题
model ChildProgress {
  id         String          @id @default(cuid())
  childId    String
  subjectId  String
  chapterId  String
  updatedAt  DateTime        @updatedAt
  child      Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  chapter    TextbookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([childId, subjectId])
}

/// 星星流水
model StarEvent {
  id        String   @id @default(cuid())
  childId   String
  amount    Int
  reason    String @db.LongText
  createdAt DateTime @default(now())
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
}

// ---------- 听写 / 背诵 / 奖励 ----------

/// 某一课的听写词表（AI 从教材原文提取，按章节缓存）
model WordList {
  id        String          @id @default(cuid())
  chapterId String          @unique
  subjectId String
  title     String
  wordsJson String @db.LongText // [{word, pinyin?, hint?}]
  createdAt DateTime        @default(now())
  chapter   TextbookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

/// 某一课要背的古诗 / 段落（AI 提取一次后落库，避免每次重新花 token）
model ReciteText {
  id         String          @id @default(cuid())
  chapterId  String          @unique
  title      String
  piecesJson String @db.LongText // RecitePiece[]
  createdAt  DateTime        @default(now())
  chapter    TextbookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

/// 背诵记录（古诗/课文）
model Recitation {
  id         String           @id @default(cuid())
  childId    String
  chapterId  String?
  title      String
  text       String
  transcript String? @db.LongText
  accuracy   Int              @default(0) // 0-100
  kind       String           @default("recite") // recite 背诵 | speaking 英语跟读
  createdAt  DateTime         @default(now())
  child      Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  chapter    TextbookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
}

/// 家长设置的奖励（星星兑换）
model Reward {
  id          String       @id @default(cuid())
  familyId    String
  title       String
  emoji       String       @default("🎁")
  stars       Int
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  redemptions Redemption[]
}

model Redemption {
  id        String    @id @default(cuid())
  childId   String
  rewardId  String
  stars     Int
  status    String    @default("pending") // pending | done | cancelled
  createdAt DateTime  @default(now())
  doneAt    DateTime?
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  reward    Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

/// 每一课的预习卡 / 微课 / 官方视频链接（按章节缓存）
model LessonGuide {
  id            String          @id @default(cuid())
  chapterId     String          @unique
  previewJson   String? @db.LongText // {summary, keyPoints[], example, questions[{q,a}]}
  explanationId String? // 微课动画（Explanation）
  videoUrl      String? @db.VarChar(512) // 国家平台课程教学页
  videoTitle    String? @db.VarChar(512)
  updatedAt     DateTime        @updatedAt
  createdAt     DateTime        @default(now())
  chapter       TextbookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// ---------- 专项 / 奥数 / 英语口语（AI 生成一次后落库复用） ----------

/// 某个专题的「讲一讲」：方法讲解 + 例题（按专题代码缓存）
model TopicLecture {
  id        String   @id @default(cuid())
  code      String   @unique // 见 src/lib/topics.ts
  json      String @db.LongText // {intro, methods[], examples[{q, steps[], answer}], tips}
  createdAt DateTime @default(now())
}

/// 英语口语跟读的句子（按主题代码缓存）
model SpeakingLesson {
  id        String   @id @default(cuid())
  code      String   @unique // 见 src/lib/speaking.ts
  title     String
  itemsJson String @db.LongText // [{en, zh, tip}]
  createdAt DateTime @default(now())
}

/// 分级阅读短文（中文 / 英文，按级别缓存成题库池）
model ReadingPiece {
  id            String   @id @default(cuid())
  lang          String // zh | en
  level         Int // 1-6
  title         String
  text          String
  questionsJson String @db.LongText // [{q, options[], answer}]
  createdAt     DateTime @default(now())

  @@index([lang, level])
}

/// 历年真题卷 / 自备试卷（家长上传 PDF / 图片 / 文本，AI 拆成题目入库，topic = paper-<id>）
model Paper {
  id        String   @id @default(cuid())
  familyId  String
  title     String
  stage     String // gaokao | zhongkao | other
  subject   String // math | chinese | english | physics | ...
  year      Int?
  source    String   @default("pdf") // pdf | image | text
  filePaths String? @db.LongText // JSON: 上传文件相对路径数组
  rawText   String? @db.LongText // 提取 / 识别出的原文
  status    String   @default("pending") // pending | parsing | ready | failed
  error     String? @db.LongText
  total     Int      @default(0)
  minutes   Int      @default(60)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, createdAt])
}
